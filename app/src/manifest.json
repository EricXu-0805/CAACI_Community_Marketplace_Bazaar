{
    "name": "Illini Market",
    "appid": "",
    "description": "UIUC campus marketplace & plaza · 华协社区二手交易",
    "versionName": "0.1.0",
    "versionCode": "1",
    "transformPx": false,
    "app-plus": {
        "usingComponents": true,
        "nvueStyleCompiler": "uni-app",
        "compilerVersion": 3,
        "splashscreen": {
            "alwaysShowBeforeRender": true,
            "waiting": true,
            "autoclose": true,
            "delay": 0
        },
        "modules": {},
        "distribute": {
            "android": {
                "permissions": [
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>"
                ],
                "permissionPhoneState": {
                    "request": "none"
                },
                "enableOAID": false
            },
            "ios": {
                "devices": "universal",
                "privacyDescription": {
                    "NSPhotoLibraryUsageDescription": "Select photos for your listings, community posts, or profile picture.",
                    "NSCameraUsageDescription": "Take photos for your listings, community posts, or profile picture."
                }
            },
            "sdkConfigs": {}
        }
    },
    "quickapp": {},
    "mp-weixin": {
        "appid": "wxc3da81aa8852a6ff",
        "darkmode": true,
        "setting": {
            "urlCheck": true,
            "es6": true,
            "minified": true,
            "postcss": true
        },
        "usingComponents": true,
        "__usePrivacyCheck__": true
    },
    "uniStatistics": {
        "enable": false
    },
    "vueVersion": "3"
}
